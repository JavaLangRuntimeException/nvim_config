#!/bin/bash
set -e

dir="${1:-.}"
dir=$(cd "$dir" 2>/dev/null && pwd) || { echo "Error: Directory not found: $1" >&2; exit 1; }

# WezTerm の user-var-changed イベントをトリガーして dev レイアウトを作成
# base64 エンコードしたディレクトリパスを SetUserVar エスケープシーケンスで送信
printf "\033]1337;SetUserVar=%s=%s\007" dev_layout "$(printf '%s' "$dir" | base64)"
dev
