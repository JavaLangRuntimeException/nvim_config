# このリポジトリの設定を動かすのに必要なもの
# brew bundle --file=Brewfile でまとめてインストールできる (install.sh からも実行される)

# シェル・ターミナル
brew "git"
brew "starship"
brew "tmux"
cask "wezterm@nightly"
cask "font-hack-nerd-font"

# Neovim と、プラグインが使う外部コマンド
brew "neovim"
brew "ripgrep"      # telescope の live grep
brew "fd"           # telescope のファイル検索
brew "node"         # copilot / Mason の LSP / tree-sitter-cli
brew "python"       # pynvim / Mason の pyright など
brew "gh"           # octo.nvim、WezTerm の Ctrl+B / Ctrl+V

# dev レイアウト (WezTerm) で起動する TUI
brew "lazygit"
brew "lazydocker"
